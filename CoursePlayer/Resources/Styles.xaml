<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:CoursePlayer.Converters"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <converters:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <converters:InverseBooleanConverter x:Key="InverseBoolean" />
    <converters:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibility" />
    <converters:PathToImageConverter x:Key="PathToImage" />

    <!-- ============================ Typography ============================ -->

    <Style x:Key="App.Text.PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextPrimary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="App.Text.Subtitle2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextPrimary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="App.Text.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="App.Text.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextDisabled}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ======================= Sidebar navigation ========================= -->

    <!--
        A nav row is a ListBoxItem so the ListBox gives us single-selection for free.
        The template is deliberately flat: 40px icon column that stays put when the
        sidebar collapses, plus a label that fades out.
    -->
    <Style x:Key="App.Sidebar.NavItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="8,2" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root"
                            Background="Transparent"
                            CornerRadius="10"
                            Height="44">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <materialDesign:PackIcon Grid.Column="0"
                                                     x:Name="Icon"
                                                     Kind="{Binding Icon}"
                                                     Width="22"
                                                     Height="22"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     Foreground="{DynamicResource App.Brush.TextPrimary}" />

                            <TextBlock Grid.Column="1"
                                       x:Name="Label"
                                       Text="{Binding Label}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,16,0"
                                       FontSize="14"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource App.Brush.TextPrimary}" />
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource App.Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource App.Brush.Hover}" />
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource App.Brush.Accent}" />
                            <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <!-- The label is hidden by the sidebar's own collapse state. -->
                        <DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Drop zone ============================= -->

    <Style x:Key="App.DropZone.Border" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Divider}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Background" Value="{DynamicResource App.Brush.Surface}" />
        <Setter Property="Padding" Value="48,40" />
    </Style>

    <!-- ========================== Video player =========================== -->

    <!--
        The scrubber. A flat 4px rail: played portion in accent, remainder transparent so
        the buffered ProgressBar behind it shows through, and a dot thumb that only grows
        on hover (YouTube behaviour).
    -->
    <Style x:Key="App.Player.Scrubber" TargetType="Slider">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="SmallChange" Value="5" />
        <Setter Property="LargeChange" Value="30" />
        <Setter Property="Height" Value="18" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge"
                                              Focusable="False"
                                              OverridesDefaultStyle="True">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4"
                                                    CornerRadius="2"
                                                    Background="{DynamicResource App.Brush.Accent}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>

                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge"
                                              Focusable="False"
                                              OverridesDefaultStyle="True">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>

                            <Track.Thumb>
                                <Thumb x:Name="Thumb"
                                       Width="13"
                                       Height="13"
                                       Focusable="False"
                                       OverridesDefaultStyle="True">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Background="Transparent">
                                                <Ellipse x:Name="Dot"
                                                         Fill="{DynamicResource App.Brush.Accent}"
                                                         Width="13"
                                                         Height="13" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Thumb" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Same rail, narrower, for the volume control. -->
    <Style x:Key="App.Player.VolumeSlider" TargetType="Slider" BasedOn="{StaticResource App.Player.Scrubber}">
        <Setter Property="Width" Value="88" />
        <Setter Property="SmallChange" Value="5" />
        <Setter Property="LargeChange" Value="10" />
    </Style>

    <!-- Transparent icon button that reads well on top of video. -->
    <Style x:Key="App.Player.IconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="18"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource App.Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One lesson row in the player's playlist panel. -->
    <Style x:Key="App.Player.PlaylistItem" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Margin" Value="6,2" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter Property="Background" Value="{DynamicResource App.Brush.Hover}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>