<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The Graphite palette, which is also the app's default theme. These literals exist so
        the very first frame the window paints is already correct: ThemeService overwrites
        every one of these brushes at startup, but XAML has to start somewhere, and starting
        on another palette's colours made the window flash before settling.

        Keep these values in sync with ThemeService.Graphite.
    -->

    <Color x:Key="App.Color.Background">#FF1E1E20</Color>
    <Color x:Key="App.Color.Surface">#FF26262A</Color>
    <Color x:Key="App.Color.SurfaceRaised">#FF2F2F34</Color>
    <Color x:Key="App.Color.Hover">#FF35353B</Color>
    <Color x:Key="App.Color.Divider">#FF3A3A40</Color>
    <Color x:Key="App.Color.TextPrimary">#FFECECEE</Color>
    <Color x:Key="App.Color.TextSecondary">#FFA6A6AD</Color>
    <Color x:Key="App.Color.TextDisabled">#FF6E6E75</Color>
    <Color x:Key="App.Color.Accent">#FF5E8B7E</Color>
    <Color x:Key="App.Color.AccentDim">#FF4C7267</Color>
    <Color x:Key="App.Color.Warning">#FFD8A657</Color>

    <!-- Chrome that frames the app: the title bar and the sidebar header. -->
    <Color x:Key="App.Color.Primary">#FF26262A</Color>

    <!-- The selected navigation row: the surface with a little accent mixed in. -->
    <Color x:Key="App.Color.Selected">#FF323C3C</Color>

    <SolidColorBrush x:Key="App.Brush.Background" Color="{StaticResource App.Color.Background}" />
    <SolidColorBrush x:Key="App.Brush.Surface" Color="{StaticResource App.Color.Surface}" />
    <SolidColorBrush x:Key="App.Brush.SurfaceRaised" Color="{StaticResource App.Color.SurfaceRaised}" />
    <SolidColorBrush x:Key="App.Brush.Hover" Color="{StaticResource App.Color.Hover}" />
    <SolidColorBrush x:Key="App.Brush.Divider" Color="{StaticResource App.Color.Divider}" />
    <SolidColorBrush x:Key="App.Brush.TextPrimary" Color="{StaticResource App.Color.TextPrimary}" />
    <SolidColorBrush x:Key="App.Brush.TextSecondary" Color="{StaticResource App.Color.TextSecondary}" />
    <SolidColorBrush x:Key="App.Brush.TextDisabled" Color="{StaticResource App.Color.TextDisabled}" />
    <SolidColorBrush x:Key="App.Brush.Accent" Color="{StaticResource App.Color.Accent}" />
    <SolidColorBrush x:Key="App.Brush.AccentDim" Color="{StaticResource App.Color.AccentDim}" />
    <SolidColorBrush x:Key="App.Brush.Warning" Color="{StaticResource App.Color.Warning}" />
    <SolidColorBrush x:Key="App.Brush.Primary" Color="{StaticResource App.Color.Primary}" />
    <SolidColorBrush x:Key="App.Brush.Selected" Color="{StaticResource App.Color.Selected}" />
    <SolidColorBrush x:Key="App.Brush.Transparent" Color="Transparent" />

</ResourceDictionary>
