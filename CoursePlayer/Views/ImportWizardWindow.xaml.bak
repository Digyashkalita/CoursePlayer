<mah:MetroWindow x:Class="CoursePlayer.Views.ImportWizardWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                 xmlns:viewModels="clr-namespace:CoursePlayer.ViewModels"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=viewModels:ImportWizardViewModel}"
                 Title="Import courses"
                 Width="620"
                 Height="560"
                 MinWidth="480"
                 MinHeight="360"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False"
                 TitleCharacterCasing="Normal"
                 Background="{DynamicResource App.Brush.Background}"
                 Foreground="{DynamicResource App.Brush.TextPrimary}"
                 FontFamily="Segoe UI">

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding HeaderText}"
                   Style="{StaticResource App.Text.PageTitle}" />

        <TextBlock Grid.Row="1"
                   Margin="0,6,0,16"
                   Style="{StaticResource App.Text.Body}"
                   Text="Tick the ones to import and rename any that need it. Each becomes a course." />

        <!-- Reviewable course rows -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Courses}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <materialDesign:Card Margin="0,0,0,10"
                                             Padding="14,12"
                                             Background="{DynamicResource App.Brush.SurfaceRaised}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0"
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}" />

                                <StackPanel Grid.Column="1">
                                    <TextBox Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Course title"
                                             FontSize="15"
                                             FontWeight="SemiBold"
                                             Foreground="{DynamicResource App.Brush.TextPrimary}"
                                             IsEnabled="{Binding IsSelected}" />

                                    <TextBlock Text="{Binding Summary}"
                                               Margin="0,6,0,0"
                                               Style="{StaticResource App.Text.Caption}" />

                                    <TextBlock Text="{Binding FolderPath}"
                                               Margin="0,2,0,0"
                                               Style="{StaticResource App.Text.Caption}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
