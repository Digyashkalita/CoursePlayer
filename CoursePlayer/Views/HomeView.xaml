<UserControl x:Class="CoursePlayer.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewModels="clr-namespace:CoursePlayer.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:HomeViewModel}"
             Background="{DynamicResource App.Brush.Background}"
             Foreground="{DynamicResource App.Brush.TextPrimary}"
             FontFamily="Segoe UI"
             AllowDrop="True"
             DragOver="OnDragOver"
             DragLeave="OnDragLeave"
             Drop="OnDrop">

    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Your courses"
                   Style="{StaticResource App.Text.PageTitle}"
                   Margin="0,0,0,20" />

        <!-- Inline load failure, rather than a modal -->
        <Border Grid.Row="1"
                VerticalAlignment="Top"
                Background="#332F2F2F"
                CornerRadius="10"
                Padding="16,12"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="AlertCircleOutline"
                                         Width="20"
                                         Height="20"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource App.Brush.Warning}" />
                <TextBlock Text="{Binding ErrorMessage}"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource App.Text.Body}" />
            </StackPanel>
        </Border>

        <!-- Empty state + drop zone -->
        <Border x:Name="DropZone"
                Grid.Row="1"
                Style="{StaticResource App.DropZone.Border}"
                MaxWidth="640"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Visibility="{Binding HasCourses, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
            <StackPanel HorizontalAlignment="Center">
                <materialDesign:PackIcon Kind="FolderMultipleOutline"
                                         Width="56"
                                         Height="56"
                                         HorizontalAlignment="Center"
                                         Foreground="{DynamicResource App.Brush.Accent}" />

                <TextBlock Text="Import a folder to get started"
                           Margin="0,16,0,0"
                           HorizontalAlignment="Center"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource App.Brush.TextPrimary}" />

                <TextBlock Margin="0,8,0,0"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           MaxWidth="440"
                           Style="{StaticResource App.Text.Body}"
                           Text="Drag a folder anywhere onto this window, or browse for one. CoursePlayer scans it for videos and documents and turns them into a course." />

                <Button Command="{Binding ImportFolderCommand}"
                        Margin="0,24,0,0"
                        Height="42"
                        MinWidth="180"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource App.Brush.Accent}"
                        BorderBrush="{DynamicResource App.Brush.Accent}"
                        Foreground="White"
                        materialDesign:ButtonAssist.CornerRadius="10">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FolderPlus" Width="20" Height="20" VerticalAlignment="Center" />
                        <TextBlock Text="Import Folder" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Course card grid: cover art, title, and a content summary per course. -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasCourses, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl ItemsSource="{Binding Courses}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!--
                            The whole card is a chromeless button so clicking it opens the course.
                            Style="{x:Null}" is required: the implicit Material Design button style
                            pins Height to 32, which clipped the card down to a 16px sliver. Opting
                            out of it lets the button size to the card's own content.
                        -->
                        <Button Style="{x:Null}"
                                Command="{Binding DataContext.OpenCourseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                Cursor="Hand"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                VerticalAlignment="Top"
                                HorizontalContentAlignment="Stretch"
                                ToolTip="Open this course">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Top" />
                                </ControlTemplate>
                            </Button.Template>
                            <materialDesign:Card Width="280"
                                                 Margin="0,0,16,16"
                                                 Background="{DynamicResource App.Brush.SurfaceRaised}"
                                                 ClipToBounds="True">
                                <StackPanel>
                                    <!--
                                        16:9 cover strip. The frame is always this size so the
                                        grid never reflows when a cover finishes generating; the
                                        folder glyph fills it until then.
                                    -->
                                    <Border Height="157"
                                            Background="{DynamicResource App.Brush.Surface}"
                                            ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding ThumbnailPath, Converter={StaticResource PathToImage}}"
                                                   Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVisibility}}" />

                                            <materialDesign:PackIcon Kind="FolderMultipleOutline"
                                                                     Width="40"
                                                                     Height="40"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center"
                                                                     Foreground="{DynamicResource App.Brush.TextDisabled}"
                                                                     Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                        </Grid>
                                    </Border>

                                    <StackPanel Margin="16,12,16,16">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource App.Brush.TextPrimary}" />
                                        <TextBlock Text="{Binding Summary}"
                                                   Margin="0,4,0,0"
                                                   Style="{StaticResource App.Text.Caption}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding FolderPath}"
                                                   Margin="0,4,0,0"
                                                   Style="{StaticResource App.Text.Caption}"
                                                   Opacity="0.65"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>
                            </materialDesign:Card>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <materialDesign:Card Grid.Row="1"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Padding="24"
                             Background="{DynamicResource App.Brush.SurfaceRaised}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             Value="0"
                             IsIndeterminate="True"
                             Width="24"
                             Height="24" />
                <TextBlock Text="Loading your library…"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource App.Text.Body}" />
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>
