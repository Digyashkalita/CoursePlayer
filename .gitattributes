# Normalize line endings: LF in the repository, native in the working copy.
* text=auto

# Windows-only tooling stays CRLF so it opens cleanly in any editor.
*.ps1 text eol=crlf
*.sln text eol=crlf

# Binary assets Git should never try to diff or convert.
*.png binary
*.jpg binary
*.ico binary
*.pdf binary
*.dll binary
